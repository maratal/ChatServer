<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - ChatServer</title>
    <!-- Prevent Chrome from requesting favicon.ico -->
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">
    <link rel="stylesheet" href="/app/css/login.css?v=#(productInfo.version)">
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <h1>ChatServer</h1>
            <p>Reset your password</p>
        </div>
        
        <div id="statusMessage" class="status-message" style="display: none;"></div>
        
        <!-- Step 1: find the account -->
        <form id="lookupForm">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" required>
                <div class="error-popup"></div>
            </div>
            <button type="submit" class="login-button">Continue</button>
        </form>
        
        <!-- Step 2: answer the security question and set a new password -->
        <form id="resetForm" style="display: none;">
            <div class="form-group">
                <label id="questionLabel" for="answer">Security question</label>
                <input type="text" id="answer" name="answer" autocomplete="off" placeholder="Your answer" required>
                <div class="error-popup"></div>
            </div>
            <div class="form-group">
                <label for="newPassword">New password</label>
                <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required>
                <div class="field-hint">8-25 characters, with an uppercase letter, a lowercase letter and a digit.</div>
                <div class="error-popup"></div>
            </div>
            <button type="submit" class="login-button">Reset Password</button>
        </form>
        
        <div class="back-link">
            <a href="/login">Back to sign in</a>
        </div>
    </div>
    
    <script src="/app/js/constants.js?v=#(productInfo.version)"></script>
    <script src="/app/js/settings.js?v=#(productInfo.version)"></script>
    <script src="/app/js/api.js?v=#(productInfo.version)"></script>
    <script>var PASSWORD_RULES_ENFORCED = #(passwordRulesEnforced);</script>
    <script src="/app/js/password-rules.js?v=#(productInfo.version)"></script>
    <script src="/app/js/forgot.js?v=#(productInfo.version)"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - ChatServer</title>
    <!-- Prevent Chrome from requesting favicon.ico -->
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">
    <link rel="stylesheet" href="/app/css/login.css?v=#(productInfo.version)">
</head>
<body>
    <div class="register-container">
        #if(registrationOpen):
        <div class="logo">
            <h1>ChatServer</h1>
            <p>Create your account</p>
        </div>
        
        <div id="statusMessage" class="status-message" style="display: none;"></div>
        
        <form id="registerForm">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" autocomplete="name" required>
                <div class="error-popup"></div>
            </div>
            
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" required>
                <div class="error-popup"></div>
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="new-password" required>
                <div class="field-hint">8-25 characters, with an uppercase letter, a lowercase letter and a digit.</div>
                <div class="error-popup"></div>
            </div>
            
            <div class="form-group">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required>
                <div class="error-popup"></div>
            </div>
            
            <div class="form-group">
                <label for="securityQuestion">Security question</label>
                <!-- An ordinary editable field with a chevron: the list only
                     fills it in, so whatever is typed is what gets saved. -->
                <div class="combo" id="questionCombo">
                    <input type="text" id="securityQuestion" name="securityQuestion" placeholder="Pick one or write your own" autocomplete="off" required>
                    <button type="button" class="combo-toggle" onclick="toggleQuestionMenu()" aria-label="Suggested questions">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="combo-menu" id="questionMenu"></div>
                </div>
                <div class="error-popup"></div>
            </div>
            
            <div class="form-group">
                <label for="securityAnswer">Answer</label>
                <input type="text" id="securityAnswer" name="securityAnswer" autocomplete="off" required>
                <div class="error-popup"></div>
            </div>
            
            <button type="submit" class="register-button">Create Account</button>
        </form>
        
        <div class="divider">
            <span>or</span>
        </div>
        
        <div class="login-link">
            <a href="/login">Already have an account? Sign in</a>
        </div>
        #else:
        <div class="registration-closed">
            <p><span class="lock-icon"></span>Registration is closed.</p>
        </div>
        #endif
    </div>

    <!-- Suggestions for the security question, templated in so the pages
         and the server cannot drift apart. -->
    <script>var SECURITY_QUESTIONS = #unsafeHTML(securityQuestionsJSON);</script>
    <script>var PASSWORD_RULES_ENFORCED = #(passwordRulesEnforced);</script>
    <script src="/app/js/password-rules.js?v=#(productInfo.version)"></script>
    <script src="/app/js/constants.js?v=#(productInfo.version)"></script>
    <script src="/app/js/svg-icons.js?v=#(productInfo.version)"></script>
    <script src="/app/js/settings.js?v=#(productInfo.version)"></script>
    <script src="/app/js/api.js?v=#(productInfo.version)"></script>
    <script src="/app/js/webpush.js?v=#(productInfo.version)"></script>
    <script src="/app/js/register.js?v=#(productInfo.version)"></script>
</body>
</html>
